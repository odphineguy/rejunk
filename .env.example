# Copy to .env and fill in. .env is gitignored.

# --- Google Maps ---
# Preferred: server-side key, used via the /maps-proxy route (kept out of the JS bundle source).
# Restrict the key by HTTP referrer in Google Cloud Console regardless of which var you use.
GOOGLE_MAPS_API_KEY=

# Alternative: client-side key, embedded in the build, loads Google Maps directly.
# VITE_GOOGLE_MAPS_API_KEY=

# --- Manus asset storage proxy (dev only; usually injected by the Manus environment) ---
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# --- Auth portal (referenced by client/src/const.ts getLoginUrl, not yet wired into the app) ---
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=

# --- Database (Phase 5+, see CLAUDE.md). Example for Supabase: ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
