{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/security/build-office-quote.mjs && vite build && tsx scripts/prerender.ts",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 12 * * *"
    }
  ]
}
